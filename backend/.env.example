# =============================================================================
# AI Lead Generation — backend environment template
# Copy to `.env` in this folder (backend/) and fill in the values you need.
# `.env` is gitignored — never commit real secrets.
# All settings map to app/core/config.py (field name = lowercase var name).
# =============================================================================

# --- App ---------------------------------------------------------------------
APP_NAME=AI Lead Generation API
ENVIRONMENT=development

# --- Database ----------------------------------------------------------------
# Dev (default): local SQLite file, zero setup:
DATABASE_URL=sqlite+aiosqlite:///./leadgen.db
# Prod (Neon Postgres) — uncomment and fill in:
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DB?ssl=require
AUTO_CREATE_TABLES=true

# --- Auth / security ---------------------------------------------------------
# REQUIRED in production: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_NAME=access_token
# Set COOKIE_SECURE=true and COOKIE_SAMESITE=none when served over HTTPS/cross-site
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Comma- or JSON-list of allowed frontend origins
CORS_ORIGINS=["http://localhost:3000"]

# --- LLM (Groq is OpenAI-compatible) -----------------------------------------
LLM_PROVIDER=groq
# Leave empty to run with deterministic fallback (no network calls)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL: must be a model your key can access (`GET /openai/v1/models`).
# Verified working with JSON output: openai/gpt-oss-120b, openai/gpt-oss-20b, allam-2-7b
GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=30

# --- Lead discovery / search (optional) --------------------------------------
# SEARCH_PROVIDER: "mock" (offline sample, default) or "serper" (live Google + Places)
SEARCH_PROVIDER=mock
SEARCH_API_KEY=
SEARCH_BASE_URL=https://google.serper.dev
SEARCH_GL=us
SEARCH_TIMEOUT_SECONDS=20

# --- Email / outreach (optional) ---------------------------------------------
# EMAIL_PROVIDER: "local" (records only, default) or "resend" (live send)
EMAIL_PROVIDER=local
EMAIL_API_KEY=
EMAIL_BASE_URL=https://api.resend.com
# Sender must be a verified domain in Resend; onboarding@resend.dev works for testing
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=AI Lead Generation
EMAIL_TIMEOUT_SECONDS=30

# --- CRM (optional) ----------------------------------------------------------
CRM_API_KEY=

# --- Embeddings / pagination -------------------------------------------------
EMBEDDING_DIM=1024
PAGE_SIZE_DEFAULT=20
PAGE_SIZE_MAX=100