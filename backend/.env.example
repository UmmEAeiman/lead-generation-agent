# =============================================================================
# AI Lead Generation — backend environment template
# Copy to `.env` in this folder (backend/) and fill in the values you need.
# `.env` is gitignored — never commit real secrets.
# All settings map to app/core/config.py (field name = lowercase var name).
# =============================================================================

# --- App ---------------------------------------------------------------------
APP_NAME=AI Lead Generation API
ENVIRONMENT=development

# --- Database ----------------------------------------------------------------
# Dev (default): local SQLite file, zero setup:
DATABASE_URL=sqlite+aiosqlite:///./leadgen.db
# Prod (Neon Postgres) — uncomment and fill in:
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DB?ssl=require
AUTO_CREATE_TABLES=true

# --- Auth / security ---------------------------------------------------------
# REQUIRED in production: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_NAME=access_token
# Set COOKIE_SECURE=true and COOKIE_SAMESITE=none when served over HTTPS/cross-site
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Comma- or JSON-list of allowed frontend origins
CORS_ORIGINS=["http://localhost:3000"]

# --- LLM (Groq is OpenAI-compatible) -----------------------------------------
LLM_PROVIDER=groq
# Leave empty to run with deterministic fallback (no network calls)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL: must be a model your key can access (`GET /openai/v1/models`).
# Verified working with JSON output: openai/gpt-oss-120b, openai/gpt-oss-20b, allam-2-7b
GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=30

# --- Lead discovery / search (optional) --------------------------------------
# SEARCH_PROVIDER: "mock" (offline sample, default) or "serper" (live Google + Places)
SEARCH_PROVIDER=mock
SEARCH_API_KEY=
SEARCH_BASE_URL=https://google.serper.dev
SEARCH_GL=us
SEARCH_TIMEOUT_SECONDS=20

# --- Email / outreach (optional) ---------------------------------------------
# EMAIL_PROVIDER: "local" (records only, default) | "smtp" (free, recommended)
#                 | "resend" (live send via API)
EMAIL_PROVIDER=local
# Sender shown on outgoing mail (must be allowed by your provider)
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=AI Lead Generation
EMAIL_TIMEOUT_SECONDS=30

# Resend (EMAIL_PROVIDER=resend)
EMAIL_API_KEY=
EMAIL_BASE_URL=https://api.resend.com

# --- SMTP (EMAIL_PROVIDER=smtp) — works with free providers ------------------
# Gmail:    SMTP_HOST=smtp.gmail.com        SMTP_PORT=587   SMTP_USE_TLS=true
#           (use a Google App Password, 2FA required)
# Brevo:    SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587   SMTP_USE_TLS=true
# SMTP2GO:  SMTP_HOST=mail.smtp2go.com      SMTP_PORT=2525  SMTP_USE_TLS=true
# Zoho:     SMTP_HOST=smtp.zoho.com         SMTP_PORT=465   SMTP_USE_SSL=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# --- Email finder / contact enrichment (optional) ----------------------------
# Finds contact emails by domain. Disabled automatically when the matching key
# is empty (email finding never runs offline and never invents an address).
# EMAIL_FINDER_PROVIDER: "hunter" | "enrich"
EMAIL_FINDER_PROVIDER=hunter
# Hunter.io (domain search + email finder)
HUNTER_API_KEY=
HUNTER_BASE_URL=https://api.hunter.io/v2
HUNTER_TIMEOUT_SECONDS=20
# Enrich.so (email finder; requires a first + last name)
ENRICH_API_KEY=
ENRICH_BASE_URL=https://dev.enrich.so
ENRICH_TIMEOUT_SECONDS=20

# --- Free contact discovery (website scrape + Serper search) -----------------
# Runs before the email finder during enrichment. Needs no key for scraping;
# reuses SEARCH_API_KEY for the Serper search step when configured.
CONTACT_FINDER_ENABLED=true
CONTACT_FINDER_TIMEOUT_SECONDS=12
CONTACT_FINDER_MAX_PAGES=6
CONTACT_FINDER_USER_AGENT=Mozilla/5.0 (compatible; LeadGenBot/1.0)

# --- CRM (optional) ----------------------------------------------------------
CRM_API_KEY=

# --- Embeddings / pagination -------------------------------------------------
EMBEDDING_DIM=1024
PAGE_SIZE_DEFAULT=20
PAGE_SIZE_MAX=100