# --- Local development ---------------------------------------------------------
# Absolute URL of the FastAPI backend (dev runs on 8001). Leave empty to use the
# Next.js /api/v1 proxy (see API_PROXY_TARGET below). Example: http://localhost:8001
NEXT_PUBLIC_API_URL=http://localhost:8001

# Where the /api/v1 rewrite proxies to. Defaults to http://localhost:8001.
# API_PROXY_TARGET=http://localhost:8001

# Optional: absolute backend URL used only by server-side fetches (Node).
# Falls back to NEXT_PUBLIC_API_URL, then http://localhost:8001.
# API_INTERNAL_URL=http://localhost:8001

# =============================================================================
# Production (Vercel) — set these in Project Settings > Environment Variables:
#   NEXT_PUBLIC_API_URL =            (empty: browser uses the same-origin proxy)
#   API_PROXY_TARGET    = https://<render-service>.onrender.com
#   API_INTERNAL_URL    = https://<render-service>.onrender.com
# =============================================================================
